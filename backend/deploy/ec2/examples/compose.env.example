# Copy to /etc/sutrai/compose.env, outside every Docker build context.
RELEASE_TAG=review-3d4370e
CONFIG_DIR=/etc/sutrai
# Initial cutover: exact existing reachable Redis URI, including TLS/auth/DB index.
REDIS_URL=rediss://REPLACE_EXISTING_REDIS_ENDPOINT:6379/0
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
