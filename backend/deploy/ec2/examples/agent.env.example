MONGODB_URI=REPLACE_EXISTING_MONGODB_URI
# Eagerly initialized SDK credentials; provider availability must be checked.
GROQ_API_KEY=REPLACE_PRIVATELY
GOOGLE_API_KEY=REPLACE_PRIVATELY
OPENROUTER_API_KEY=REPLACE_PRIVATELY
TAVILY_API_KEY=REPLACE_PRIVATELY
# Retain the existing endpoint. Current adapter does not pass Qdrant API keys.
QDRANT_URL=REPLACE_EXISTING_QDRANT_URL
AWS_REGION=REPLACE_EXISTING_REGION
AWS_BUCKET_NAME=REPLACE_EXISTING_ARTIFACT_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_PRIVATELY
# Exact name used by config/s3.js; AWS_SECRET_ACCESS_KEY is not read there.
AWS_SECRET_KEY=REPLACE_PRIVATELY
